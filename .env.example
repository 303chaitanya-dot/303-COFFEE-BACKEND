# Local default. Render sets this to Postgres automatically.
DATABASE_URL=sqlite:///./data/cafe.db

CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹

# Change this in production.
SECRET_KEY=dev-only-change-me

ADMIN_EMAIL=admin@303coffee.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Owner

# Needed to read photo/PDF bills. A .txt bill works without this.
OPENAI_API_KEY=

# From Pet Pooja (support@petpooja.com). Webhook is usable before these are set.
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
PETPOOJA_REST_ID=
PETPOOJA_WEBHOOK_SECRET=
